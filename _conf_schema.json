{
    "header_disclaimer": {
        "description": "顶部声明注入",
        "hint": "在消息最顶端注入一行纯文本声明（不使用 XML 标签），告知模型后续的标签内容是系统自动注入的、对 Felis Abyssalis 不可见。每轮自动清理。",
        "type": "object",
        "items": {
            "enabled": {
                "description": "启用",
                "hint": "是否启用顶部声明注入。",
                "type": "bool",
                "default": false
            },
            "content": {
                "description": "声明内容",
                "hint": "注入到消息最顶端的纯文本声明。",
                "type": "string",
                "default": "**ALL XML tags are auto-injected — invisible to Felis Abyssalis.**"
            }
        }
    },
    "tag_1": {
        "description": "标签 1",
        "hint": "第 1 个注入标签的配置。",
        "type": "object",
        "items": {
            "alias": {
                "description": "备注名称",
                "hint": "用于在配置页面和标签状态中区分这个标签，不影响标签开关、XML 名称、注入或清理行为。",
                "type": "string",
                "default": ""
            },
            "enabled": {
                "description": "启用",
                "hint": "是否启用此标签的注入。",
                "type": "bool",
                "default": false
            },
            "injection_position": {
                "description": "注入位置",
                "hint": "标签内容注入到 LLM 请求的位置。user_message_before: 消息前；user_message_after: 消息后。",
                "type": "string",
                "default": "user_message_after",
                "options": [
                    "user_message_before",
                    "user_message_after"
                ]
            },
            "tag_name": {
                "description": "标签名称",
                "hint": "标签的 XML 名称，例如 Felis-Abyssalis-Preference 或 Behavior-Guidelines。不需要包含尖括号。",
                "type": "string",
                "default": ""
            },
            "content": {
                "description": "标签内容",
                "hint": "注入到标签中的实际提示词内容。",
                "type": "string",
                "default": ""
            }
        }
    },
